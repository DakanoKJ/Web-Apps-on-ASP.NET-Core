@model EmailConfirmationViewModel

<form asp-action="ConfirmEmail" asp-controller="EmailConfirmation" method="post">
    <input type="hidden" asp-for="AccountId" value="@Model.AccountId"/>
    <input type="hidden" asp-for="Token" value="@Model.Token"/>
    <button class="btn btn-primary" type="submit">Подтвердить почту</button>
</form>

