@model PersonalAccount.Models.PasswordChangeViewModel

@{
    ViewData["Title"] = "Смена пароля";
}

<div class="container">
    <h1 class="mb-4">Смена пароля</h1>

    <form method="post" asp-controller="Cabinet" asp-action="ChangePassword" id="changePasswordForm">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="OldPassword" class="form-label">Текущий пароль</label>
            <input asp-for="OldPassword" type="password" class="form-control" />
            <span asp-validation-for="OldPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="NewPassword" class="form-label">Новый пароль</label>
            <input asp-for="NewPassword" type="password" class="form-control" id="newPassword" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="ConfirmNewPassword" class="form-label">Подтверждение нового пароля</label>
            <input asp-for="ConfirmNewPassword" type="password" class="form-control" id="confirmNewPassword" />
            <span asp-validation-for="ConfirmNewPassword" class="text-danger"></span>
            <div id="confirmError" class="text-danger" style="display:none;">Пароли не совпадают</div>
            <div id="samePasswordError" class="text-danger" style="display:none;">Новый пароль не должен совпадать со старым</div>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-controller="Cabinet" asp-action="Edit" class="btn btn-secondary">Отмена</a>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
    <script>
        document.getElementById('changePasswordForm').addEventListener('submit', function (e) {
            const oldPass = document.querySelector('[name="OldPassword"]').value;
            const newPass = document.getElementById('newPassword').value;
            const confirmPass = document.getElementById('confirmNewPassword').value;
            const confirmError = document.getElementById('confirmError');
            const samePasswordError = document.getElementById('samePasswordError');

            confirmError.style.display = 'none';
            samePasswordError.style.display = 'none';

            let hasError = false;

            if (newPass !== confirmPass) {
                confirmError.style.display = 'block';
                hasError = true;
            }

            if (oldPass === newPass && newPass !== '') {
                samePasswordError.style.display = 'block';
                hasError = true;
            }

            if (hasError) e.preventDefault();
        });
    </script>
}
