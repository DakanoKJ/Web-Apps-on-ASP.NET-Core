@model PersonalAccount.Models.StudentEditViewModel

@{
    ViewData["Title"] = "Редактирование профиля";
}

<div class="container">
    <h1 class="mb-4">Редактирование профиля</h1>

    <form method="post" asp-controller="Cabinet" asp-action="Edit">
        <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

        <div class="mb-3">
            <label asp-for="FullName" class="form-label">Имя</label>
            <input asp-for="FullName" class="form-control" />
            <span asp-validation-for="FullName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="GroupName" class="form-label">Группа</label>
            <input asp-for="GroupName" class="form-control" />
            <span asp-validation-for="GroupName" class="text-danger"></span>
        </div>

        <div class="mb-3">
            <label asp-for="PhotoUrl" class="form-label">Ссылка на фото</label>
            <input asp-for="PhotoUrl" class="form-control" />
            <span asp-validation-for="PhotoUrl" class="text-danger"></span>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-primary">Сохранить</button>
            <a asp-controller="Cabinet" asp-action="Index" class="btn btn-secondary">Отмена</a>
            <button type="submit" formmethod="get" formaction="@Url.Action("ChangePassword", "Cabinet")" class="btn btn-outline-warning ms-auto">
                Сменить пароль
            </button>
        </div>
    </form>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
