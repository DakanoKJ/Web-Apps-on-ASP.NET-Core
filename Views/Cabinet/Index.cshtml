@model StudentModel

@{
    ViewData["Title"] = "Личный кабинет";
}

<div class="container">
    <div class="d-flex justify-content-between align-content-center">
        <h1 class="mb-4">Личный кабинет студента</h1>
        <form method="post" asp-controller="Account" asp-action="Logout">
            <button class="btn btn-secondary" type="submit">Выйти</button>
        </form>
    </div>

    <div class="card">
        @if (Model.PhotoUrl != null)
        {
            <img class="card-img-top" src="@Model.PhotoUrl" alt="Фото студента"/>
        }
        <header class="card-header">
            @Model.FullName
        </header>

        <div class="card-body">
            <p class="mb-1">
                Группа: @Model.GroupName
            </p>
            <p class="mb-1">
                Email: @Model.Email
            </p>
        </div>
    </div>
</div>
